{
  "name": "@amlplugins/atlassian-confluence",
  "version": "0.0.1",
  "description": "Native confluence.js SDK re-exported under the @amlplugins namespace — Confluence Cloud REST API v2 — spaces, pages, blog posts, comments, attachments, properties.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "confluence.js": "^1.7.4",
    "atlassian-jwt": "^2.0.3"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amlplugins/atlassian-confluence.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
